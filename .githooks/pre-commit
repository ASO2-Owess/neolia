#!/bin/sh
# Hook pre-commit : bloque les commits qui casseraient la sécurité ou le build.
# Activation (une seule fois par clone) : npm run hooks
set -e
echo "→ pre-commit : contrôle des sources, build et vérifications"
node scripts/check.mjs --source
node scripts/build.mjs >/dev/null
node scripts/check.mjs
